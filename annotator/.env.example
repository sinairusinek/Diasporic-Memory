# Copy to .env.local and fill in. Never commit .env.local.

# The single shared password the PI types at /login.
ANNOTATOR_PASSWORD=

# 32+ random bytes used to sign the session cookie.
#   openssl rand -base64 32
ANNOTATOR_SECRET=

# Neon / Vercel Postgres connection string.
POSTGRES_URL=

# Optional: read/write token for the Vercel Blob store holding page scans.
# Without it the app runs fine, just with no facsimile images.
BLOB_READ_WRITE_TOKEN=
