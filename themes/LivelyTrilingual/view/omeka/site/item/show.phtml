$tr = function (string $key) use ($T, $shortLang) {
    return $T[$key][$shortLang] ?? $T[$key]['en'] ?? $key;
};

// Helper: pick a property value in current short lang, falling back to untagged,
// or returning the placeholder if only other-lang values exist.
$pickLocal = function ($resource, $term, $allowPlaceholder = true) use ($shortLang, $placeholder) {
    $vals = $resource->value($term, ['all' => true, 'default' => []]);
    if (!$vals) return null;
    $untagged = []; $current = []; $otherLang = false;
    foreach ($vals as $v) {
        $vl = (string) $v->lang();
        if ($vl === '') $untagged[] = $v;
        elseif (strcasecmp(substr($vl, 0, 2), $shortLang) === 0) $current[] = $v;
        else $otherLang = true;
    }
    if ($current) return (string) $current[0]->value();
    if ($untagged) return (string) $untagged[0]->value();
    return ($allowPlaceholder && $otherLang) ? $placeholder : null;
};

// Identifier for this resource (used for sibling nav and theme lookup).
